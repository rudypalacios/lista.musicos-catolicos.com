Options All -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

<Files .htaccess>
  order allow,deny
  deny from all
</Files>

#
# This is a private app: keep it out of search engines, and out of frames
#
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  # Only the origin, and only to a secure site: YouTube's player refuses to play with no referrer at all
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Everything comes from this origin: no CDNs, fonts or scripts from elsewhere. If a change
  # needs another domain, widen this on purpose (and check the privacy policy first). The one exception: YouTube's player
  # (frame-src), which the page only creates when the person touches "Escuchar aquí" on a song with a link.
  # 'wasm-unsafe-eval' lets WebAssembly run (the photo reader, web/src/ocr/): it does not allow eval() of text.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; frame-src https://www.youtube-nocookie.com"
</IfModule>

#
# Compression
#
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

#
# Cache. The build gives JS and CSS a content hash in the name (main-AB12CD34.js), so those
# never change under the same URL. The files that name them must always be revalidated: the
# service worker, the shell, the manifest and the icons (a phone keeps an icon by its address for days:
# a new drawing goes in a new folder of public/icons/, and the old addresses revalidate).
#
<IfModule mod_headers.c>
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest|apple-touch-icon\.png|favicon\.ico|favicon-(16x16|32x32)\.png|android-chrome-(192x192|512x512)\.png)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files (assets, the worker, icons) are served as they are; everything else goes to
  # index.php, which answers the API and gives the app shell to any other URL.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>
