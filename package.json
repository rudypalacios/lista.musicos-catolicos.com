{
  "name": "lista-musicos-catolicos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p web/tsconfig.sw.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
