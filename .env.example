# Copy to .env on the server (never commit .env).
APP_ENV=production

DB_HOST=localhost
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# The owner account is created on the first request that finds no users. Use the bcrypt
# hash (password_hash($password, PASSWORD_BCRYPT), starts with $2y$) and keep the single
# quotes: the hash contains "$". Keeps the password itself out of the server's files.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=''
# Alternative: the plain password, hashed on the first request. Delete it after signing in.
# OWNER_PASSWORD=

# The address of the site, for the links in the emails (confirm the address, choose a new password).
# Never taken from the request. If it is not set, the production address is used.
# APP_URL=https://lista.musicos-catolicos.com

# The mailbox the app sends from (create it in cPanel: Email Accounts). The names are the ones of the owner's other
# system. Without MAIL_HOST (or with MAIL_DRIVER=log) the app sends nothing: it writes the message to the error log,
# so sign-ups work but nobody receives the link.
# MAIL_DRIVER=smtp
# MAIL_HOST=mail.musicos-catolicos.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl        # ssl (port 465), tls (STARTTLS, port 587) or none
# MAIL_USERNAME=noreply@musicos-catolicos.com
# MAIL_PASSWORD=''
# MAIL_FROM_ADDRESS=noreply@musicos-catolicos.com
# MAIL_FROM_NAME='Músicos Católicos'
# MAIL_REPLY_TO=noreply@musicos-catolicos.com

# Local development and tests only: SQLite instead of MySQL.
# DB_DRIVER=sqlite
# DB_PATH=var/lista.sqlite
