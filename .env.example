# Copy to .env on the server (never commit .env).
APP_ENV=production

DB_HOST=localhost
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# The owner account is created on the first request that finds no users. Use ONE of the
# two. After the first login, delete OWNER_PASSWORD from .env (the hash is already stored).
OWNER_EMAIL=
OWNER_PASSWORD=
# OWNER_PASSWORD_HASH=

# Local development and tests only: SQLite instead of MySQL.
# DB_DRIVER=sqlite
# DB_PATH=var/lista.sqlite
